@startuml
autonumber
actor "Gym User" as User
participant "JournalActivity" as UI
participant "Android OS\n(Camera/Gallery)" as OS
participant "AlertDialog\n(Entry Dialog)" as Dialog
participant "FileOutputStream" as FOS
participant "File (Storage)" as File
participant "JournalAdapter" as Adapter

activate User
alt Take Photo via Camera
    User -> UI : clicks Take Photo button
    activate UI
    UI -> OS : startActivityForResult(ACTION_IMAGE_CAPTURE)
    activate OS
    OS --> UI : onActivityResult(RESULT_OK, data)
    deactivate OS
else Choose from Gallery
    User -> UI : clicks Gallery button
    UI -> OS : startActivityForResult(ACTION_PICK)
    activate OS
    OS --> UI : onActivityResult(RESULT_OK, data)
    deactivate OS
end

UI -> Dialog ** : showEntryDetailsDialog(photoBitmap)
activate Dialog
Dialog --> User : displays photo preview and prompts for weight and height
deactivate Dialog

User -> Dialog : inputs metrics and clicks Save
activate Dialog
Dialog -> UI : onSave(weight, height)
deactivate Dialog

UI -> File ** : new File(getFilesDir()/journal, "journal_<timestamp>.jpg")
UI -> FOS ** : new FileOutputStream(file)
activate FOS
UI -> FOS : bitmap.compress(JPEG, 90, fos)
UI -> FOS : close()
deactivate FOS

UI -> UI : persistEntries()
note right of UI: Appends new JournalEntry and writes\nupdated list to entries.json (Gson)

UI -> UI : loadEntries()
UI -> Adapter : notifyDataSetChanged()
activate Adapter
Adapter --> UI : gallery refreshed with date and metrics
deactivate Adapter

UI --> User : displays updated evolution journal
deactivate UI

opt User clicks Delete on an entry
    User -> UI : clicks Delete button
    activate UI
    UI -> Dialog ** : confirmDeleteEntry()
    activate Dialog
    Dialog --> User : prompts confirmation ("Are you sure?")
    deactivate Dialog
    User -> Dialog : clicks Yes
    activate Dialog
    Dialog -> UI : deleteEntry(position)
    deactivate Dialog
    UI -> File : delete()
    UI -> UI : persistEntries()
    UI -> Adapter : notifyDataSetChanged()
    activate Adapter
    Adapter --> UI : entry removed
    deactivate Adapter
    deactivate UI
end

deactivate User
@enduml
