@startuml
autonumber
actor "Gym User" as User
participant "MainActivity /\nProfileActivity" as UI
participant "SharedPrefsUtils" as Prefs
participant "SharedPreferences.Editor" as Editor
participant "LoginActivity" as Login

activate User
User -> UI : clicks Logout (menu option or profile button)
activate UI

UI -> Prefs : clearSession(context)
activate Prefs

Prefs -> Editor : edit()
activate Editor
Prefs -> Editor : clear()
Prefs -> Editor : apply()
note right of Editor: Clears stored email & token\nin private XML storage
deactivate Editor
Prefs --> UI : session cleared
deactivate Prefs

UI -> Login ** : new Intent(context, LoginActivity.class)
note right of UI: Sets flags:\nFLAG_ACTIVITY_NEW_TASK |\nFLAG_ACTIVITY_CLEAR_TASK\nto clear Android Back Stack

UI -> UI : startActivity(intent)
UI -> UI : finish()

deactivate UI
deactivate User
@enduml
