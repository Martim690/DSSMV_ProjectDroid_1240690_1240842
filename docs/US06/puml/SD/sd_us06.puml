@startuml
autonumber
actor "Gym User" as User
participant "MainActivity" as UI
participant "Toolbar" as Toolbar
participant "ActionBar" as ActionBar

activate User
User -> UI : launches / enters MainActivity
activate UI

UI -> UI : setContentView(R.layout.activity_main)
UI -> Toolbar : findViewById(R.id.toolbar)
activate Toolbar
Toolbar --> UI : toolbar
deactivate Toolbar

UI -> UI : setSupportActionBar(toolbar)
UI -> ActionBar : setTitle(R.string.app_name)
activate ActionBar
ActionBar --> UI : title set
deactivate ActionBar

UI --> User : displays main dashboard with toolbar header
deactivate UI
deactivate User
@enduml
