@startuml
skinparam classAttributeIconSize 0

package "mrgym.models" {
    class User {
        - String _id
        - String email
        - String password
        - String name
        + User()
        + User(String email, String password, String name)
        + getId(): String
        + setId(String _id): void
        + getEmail(): String
        + setEmail(String email): void
        + getPassword(): String
        + setPassword(String password): void
        + getName(): String
        + setName(String name): void
        + toString(): String
    }

    class Exercise {
        - int id
        - String name
        - String description
        + Exercise()
        + Exercise(int id, String name, String description)
        + getId(): int
        + setId(int id): void
        + getName(): String
        + setName(String name): void
        + getDescription(): String
        + setDescription(String description): void
        + toString(): String
    }

    class WorkoutPlan {
        - String _id
        - String name
        - List<Exercise> exercises
        + WorkoutPlan()
        + WorkoutPlan(String name, List<Exercise> exercises)
        + getId(): String
        + setId(String _id): void
        + getName(): String
        + setName(String name): void
        + getExercises(): List<Exercise>
        + setExercises(List<Exercise> exercises): void
        + toString(): String
    }

    class WorkoutLog {
        - String _id
        - String userId
        - String date
        - int durationMinutes
        + WorkoutLog()
        + WorkoutLog(String userId, String date, int durationMinutes)
        + getId(): String
        + setId(String _id): void
        + getUserId(): String
        + setUserId(String userId): void
        + getDate(): String
        + setDate(String date): void
        + getDurationMinutes(): int
        + setDurationMinutes(int durationMinutes): void
        + toString(): String
    }
}

package "mrgym.views" {
    class CustomAdapter {
        - Context context
        - List<Exercise> exerciseList
        + CustomAdapter(Context context, List<Exercise> exerciseList)
        + getCount(): int
        + getItem(int position): Object
        + getItemId(int position): long
        + getView(int position, View convertView, ViewGroup parent): View
    }

    class JournalAdapter {
        - Context context
        - List<File> photoList
        - OnDeleteClickListener deleteListener
        + JournalAdapter(Context context, List<File> photoList, OnDeleteClickListener deleteListener)
        + getCount(): int
        + getItem(int position): Object
        + getItemId(int position): long
        + getView(int position, View convertView, ViewGroup parent): View
    }
}

package "mrgym.exceptions" {
    class InvalidCredentialsException {
        + InvalidCredentialsException(String message)
    }
}

package "mrgym.controllers" {
    class LoginActivity {
        - EditText etEmail
        - EditText etPassword
        - Button btnLogin
        - Button btnGoToRegister
        # onCreate(Bundle savedInstanceState): void
        - loginUser(String email, String password): void
    }

    class RegisterActivity {
        - EditText etName
        - EditText etEmail
        - EditText etPassword
        - Button btnRegister
        - Button btnGoToLogin
        # onCreate(Bundle savedInstanceState): void
        - registerUser(String name, String email, String password): void
    }

    class MainActivity {
        - Toolbar toolbar
        - ListView listViewExercises
        - CustomAdapter adapter
        - List<Exercise> exerciseList
        - Button btnJournal
        - Button btnWorkout
        - Button btnProfile
        # onCreate(Bundle savedInstanceState): void
        + onCreateOptionsMenu(Menu menu): boolean
        + onOptionsItemSelected(MenuItem item): boolean
    }

    class WorkoutActivity {
        - Toolbar toolbar
        - ListView listViewWorkouts
        - TextView tvEmptyWorkouts
        - Button btnAddWorkout
        # onCreate(Bundle savedInstanceState): void
        + onSupportNavigateUp(): boolean
    }

    class ProfileActivity {
        - TextView tvUserEmail
        - Button btnLogoutProfile
        - Button btnBackProfile
        # onCreate(Bundle savedInstanceState): void
    }

    class JournalActivity {
        - Toolbar toolbar
        - Button btnTakePhoto
        - ListView listViewJournal
        - TextView tvEmptyJournal
        - JournalAdapter adapter
        - List<File> photoList
        # onCreate(Bundle savedInstanceState): void
        + onSupportNavigateUp(): boolean
        # onResume(): void
        - checkCameraPermission(): void
        - openCamera(): void
        - savePhoto(Bitmap bitmap): void
        - loadPhotos(): void
        - deletePhoto(int position): void
    }

    class SharedPrefsUtils {
        - {static} String PREF_NAME
        - {static} String KEY_EMAIL
        - {static} String KEY_TOKEN
        + {static} saveSession(Context context, String email, String token): void
        + {static} getEmail(Context context): String
        + {static} clearSession(Context context): void
    }

    class RestClient {
        + {static} makeRequest(String urlString, String method, String jsonBody, String apiKey, VolleyCallback callback): void
    }
}

WorkoutPlan "1" o-- "*" Exercise : contains
MainActivity --> CustomAdapter : uses
CustomAdapter --> Exercise : displays
MainActivity --> JournalActivity : launches
MainActivity --> WorkoutActivity : launches
MainActivity --> ProfileActivity : launches
ProfileActivity --> LoginActivity : launches
JournalActivity --> JournalAdapter : uses
LoginActivity ..> SharedPrefsUtils : reads/writes
ProfileActivity ..> SharedPrefsUtils : reads/clears
MainActivity ..> SharedPrefsUtils : clears
LoginActivity ..> RestClient : invokes
RegisterActivity ..> RestClient : invokes
LoginActivity ..> InvalidCredentialsException : throws

@enduml
