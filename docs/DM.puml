@startuml
skinparam classAttributeIconSize 0
hide empty methods

class User {
    email
    password
    name
}

class WorkoutPlan {
    name
}

class Exercise {
    id
    name
    description
}

class WorkoutLog {
    date
    durationMinutes
}

class EvolutionPhoto {
    date
    filePath
}

User "1" --> "0..*" WorkoutPlan : creates >
User "1" --> "0..*" WorkoutLog : logs >
User "1" --> "0..*" EvolutionPhoto : captures in Journal >
WorkoutPlan "1" --> "1..*" Exercise : contains >
WorkoutLog "0..*" --> "1" WorkoutPlan : references >

@enduml
