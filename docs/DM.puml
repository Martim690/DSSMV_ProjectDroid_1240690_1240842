@startuml
skinparam classAttributeIconSize 0
hide empty methods

class User {
    email
    password
    name
}

class WorkoutPlan {
    name
    userEmail
}

class Exercise {
    id
    name
    description
    imageUrl
    sets
    reps
    weight
}

class WorkoutLog {
    date
    durationMinutes
}

class JournalEntry {
    date
    photoPath
    weight
    height
    userEmail
}

User "1" --> "0..*" WorkoutPlan : creates >
User "1" --> "0..*" WorkoutLog : logs >
User "1" --> "0..*" JournalEntry : records >
WorkoutPlan "1" --> "1..*" Exercise : contains >
WorkoutLog "0..*" --> "1" WorkoutPlan : references >

@enduml
