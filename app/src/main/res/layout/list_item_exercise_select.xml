<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:descendantFocusability="afterDescendants"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivExercisePhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="#EFEFEF"
        android:contentDescription="Exercise Photo"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark_green" />

        <TextView
            android:id="@+id/tvExerciseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_color_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Row 1: Sets & Reps -->
        <LinearLayout
            android:id="@+id/layoutSetsReps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sets:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark_green" />

            <Button
                android:id="@+id/btnMinusSets"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="-"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="false"
                android:padding="0dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@color/black"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tvSetsValue"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark_green" />

            <Button
                android:id="@+id/btnPlusSets"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="+"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="false"
                android:padding="0dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reps:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark_green"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btnMinusReps"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="-"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="false"
                android:padding="0dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@color/black"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tvRepsValue"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="10"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark_green" />

            <Button
                android:id="@+id/btnPlusReps"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="+"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="false"
                android:padding="0dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@color/black" />

        </LinearLayout>

        <!-- Row 2: Weight (Direct input) -->
        <LinearLayout
            android:id="@+id/layoutWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark_green" />

            <EditText
                android:id="@+id/etWeightValue"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:hint="0"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="@color/primary_dark_green"
                android:background="@android:drawable/editbox_background_normal"
                android:padding="2dp"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_secondary"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <CheckBox
        android:id="@+id/cbExerciseSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginStart="8dp" />

</LinearLayout>
