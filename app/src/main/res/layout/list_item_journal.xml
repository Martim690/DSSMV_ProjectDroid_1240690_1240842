<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/ivJournalPhoto"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:scaleType="centerCrop"
        android:background="@color/black"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/label_journal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/tvJournalDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_color_primary" />

        <Button
            android:id="@+id/btnDeletePhoto"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="28dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/btn_delete"
            android:textSize="10sp"
            android:backgroundTint="@color/primary_dark_green"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvJournalMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_color_secondary" />

</LinearLayout>
